[Unit]
Description=AMD Radeon Profile daemon
After=local-fs.target systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/radeon-profile-daemon
Restart=on-failure
RestartSec=5

# No PrivateTmp: the daemon must share /tmp with the GUI, which creates the shared memory key file
# (/tmp/qipc_sharedmemory_*) there and reads the debugfs clocks copy (/tmp/*_pm_info) from it

# Security hardening — Compatible with the application need to write to /sys/class/drm/ for fan control and power settings
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
